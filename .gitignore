node_modules/
dist/
.DS_Store
*.log
# Source frames are 239 MB of JPEGs; keep them out of the working tree.
# tools/build-frames.mjs reads them from CAHA_SRC_FRAMES and writes the
# optimised web set that actually ships.
assets/frames/
# (gitignore has no trailing comments: the comment must be on its own line)
assets/web/
assets/web-1600/
assets/web-960/
assets/web-m/
assets/web-avif/

# Audit output: the JSON reports are small and are committed as evidence
# (reports/browser-audit-<label>.json); screenshots and per-frame traces are
# regenerated on every run and are not.
reports/shots/
reports/traces/
reports/*.tmp.json
